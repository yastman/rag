# .env.local.example
# Шаблон для локальной разработки
# Скопируйте в .env и заполните значения

# === API Keys ===
OPENAI_API_KEY=[REDACTED-OPENAI-KEY]
ANTHROPIC_API_KEY=[REDACTED-ANTHROPIC-KEY]
GROQ_API_KEY=[REDACTED-GROQ-KEY]

# === Local Services (docker-compose.local.yml) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Пустой для локальной разработки
GDRIVE_SYNC_DIR=/absolute/path/to/drive-sync
GDRIVE_COLLECTION_NAME=gdrive_documents_bge
BGE_M3_URL=http://localhost:8001
DOCLING_URL=http://localhost:5001
REDIS_URL=redis://localhost:6379

# === Telegram Bot (опционально) ===
TELEGRAM_BOT_TOKEN=[REDACTED-TELEGRAM-TOKEN]

# === LLM Settings ===
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
