***REMOVED*** syntax=docker/dockerfile:1@sha256:b6afd42430b15f2d2a4c5a02b919e98a525b785b1aaff16747d2f623364e39b6
***REMOVED*** Unified Ingestion Pipeline — uv SDK pattern (Context7 best practices 2026)
***REMOVED*** CPU-only PyTorch via [tool.uv.sources] in pyproject.toml
***REMOVED*** Target: 28GB → <5GB (remove nvidia/cuda/triton)

***REMOVED*** =============================================================================
***REMOVED*** Build stage
***REMOVED*** =============================================================================
***REMOVED*** Pin uv version — checked 2026-02-09
FROM ghcr.io/astral-sh/uv:0.9-python3.14-bookworm-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

***REMOVED*** Install system build dependencies with apt cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++

***REMOVED*** Install dependencies (deps change rarely — cached layer)
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --extra ingest --no-install-project

***REMOVED*** Copy dependency files for final sync
COPY pyproject.toml uv.lock ./

***REMOVED*** Copy application code (changes often — separate layer)
COPY src/ ./src/
COPY telegram_bot/ ./telegram_bot/

***REMOVED*** Final sync with project installation
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra ingest

***REMOVED*** =============================================================================
***REMOVED*** Runtime stage
***REMOVED*** =============================================================================
FROM python:3.14-slim-bookworm@sha256:55e465cb7e50cd1d7217fcb5386aa87d0356ca2cd790872142ef68d9ef6812b4 AS runtime

WORKDIR /app

***REMOVED*** Install runtime deps (procps for healthcheck)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends procps

***REMOVED*** Create non-root user BEFORE copying files
RUN useradd -m -u 1000 ingestion

***REMOVED*** Copy uv binary from builder (same version as build stage)
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv

***REMOVED*** Copy venv with --chown (avoids 9GB duplicate layer from chown -R)
COPY --from=builder --chown=ingestion:ingestion /app/.venv /app/.venv

***REMOVED*** Copy project files with --chown
COPY --chown=ingestion:ingestion pyproject.toml uv.lock ./
COPY --chown=ingestion:ingestion src/ ./src/
COPY --chown=ingestion:ingestion telegram_bot/ ./telegram_bot/

USER ingestion

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f "src.ingestion.unified.cli" || exit 1

STOPSIGNAL SIGTERM

ENTRYPOINT ["/app/.venv/bin/python", "-m", "src.ingestion.unified.cli"]
CMD ["run", "--watch"]
