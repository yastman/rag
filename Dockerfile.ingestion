# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# Unified Ingestion Pipeline — uv SDK pattern (Context7 best practices 2026)
# CPU-only PyTorch via [tool.uv.sources] in pyproject.toml
# Target: 28GB → <5GB (remove nvidia/cuda/triton)

# =============================================================================
# Build stage
# =============================================================================
# Pin uv version — checked 2026-02-09
FROM ghcr.io/astral-sh/uv:0.9-python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

# Install system build dependencies with apt cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++

# Install dependencies (deps change rarely — cached layer)
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --extra docling-native --no-install-project

# Copy dependency files for final sync
COPY pyproject.toml uv.lock ./

# Copy application code (changes often — separate layer)
# telegram_bot/ is NOT copied: ingestion entrypoint (src.ingestion.unified.cli)
# only imports from src.*; see #2636 audit.
COPY src/ ./src/

# Final sync with project installation
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra docling-native

# =============================================================================
# Ф4: Build-time model pre-warming (card_988bc8421954)
# Bake Docling layout/table/vision artifacts and BGE-M3 HF cache into the image
# so cold-start ingestion is fully offline (no network on first run).
# Tradeoff: thicker image (~2–4 GB extra). See ADR in card_988bc8421954.
# =============================================================================

# Docling artifacts: layout, tableformer, code_formula, picture_classifier, rapidocr
RUN .venv/bin/python -m pip install --quiet docling-tools 2>/dev/null || true && \
    .venv/bin/python -c "from docling.cli.main import download_models; download_models()" 2>/dev/null || \
    .venv/bin/docling tools models download layout tableformer code_formula picture_classifier rapidocr \
        --output-dir /opt/docling/models 2>/dev/null || \
    echo "Docling model pre-warm step — will retry at runtime if CLI not available"

# BGE-M3: HuggingFace model cache (not a Docling artifact — warm separately)
# hadolint ignore=DL3059
RUN .venv/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='BAAI/bge-m3', cache_dir='/opt/huggingface/hub', ignore_patterns=['*.ot', 'flax*', 'tf_*'])" \
    2>/dev/null || echo "BGE-M3 pre-warm — will download at runtime if offline cache missing"

# =============================================================================
# Runtime stage
# =============================================================================
FROM python:3.13-slim-bookworm@sha256:e4fa1f978c539608a10cdf74700ac32a3f719dfc6e8b6b6001da82deb36302a2 AS runtime

LABEL org.opencontainers.image.source="https://github.com/yastman/rag"

WORKDIR /app

# Install runtime deps (procps for healthcheck, gosu for privilege drop)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends procps gosu

# Create non-root user BEFORE copying files
RUN useradd -m -u 1000 ingestion

# Copy uv binary from builder (same version as build stage)
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv

# Copy venv with --chown (avoids 9GB duplicate layer from chown -R)
COPY --from=builder --chown=ingestion:ingestion /app/.venv /app/.venv

# Copy project files with --chown
COPY --chown=ingestion:ingestion pyproject.toml uv.lock ./
COPY --chown=ingestion:ingestion src/ ./src/
COPY docker/ingestion/entrypoint.sh /usr/local/bin/ingestion-entrypoint.sh

# Ф4: Copy baked model artifacts from builder (Docling + BGE-M3)
COPY --from=builder --chown=ingestion:ingestion /opt/docling /opt/docling
COPY --from=builder --chown=ingestion:ingestion /opt/huggingface /opt/huggingface

RUN chmod +x /usr/local/bin/ingestion-entrypoint.sh

ENV PATH="/app/.venv/bin:${PATH}" \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DOCLING_ARTIFACTS_PATH=/opt/docling/models \
    HF_HOME=/opt/huggingface \
    HF_HUB_CACHE=/opt/huggingface/hub \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f "src.ingestion.unified.cli" || exit 1

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/ingestion-entrypoint.sh"]
CMD ["run", "--watch"]
