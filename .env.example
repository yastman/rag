GDRIVE_COLLECTION_NAME=gdrive_documents_bge
INGESTION_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cocoindex

***REMOVED*** ==============================================================================
***REMOVED*** LLM TUNING (advanced)
***REMOVED*** ==============================================================================
***REMOVED*** Bot calls LLM via LiteLLM proxy by default. Override per provider via the
***REMOVED*** proxy config (config/litellm.yaml) — these knobs only affect bot-side request
***REMOVED*** kwargs and graph behaviour.
LLM_BASE_URL=http://localhost:4000
LLM_MODEL=gpt-4o-mini
***REMOVED*** LLM_API_KEY=                          ***REMOVED*** Per-provider override; usually not needed (LiteLLM proxy).
***REMOVED*** LITELLM_BASE_URL=http://localhost:4000  ***REMOVED*** Alias used by some scripts (***REMOVED***1670).
***REMOVED*** LLM_TEMPERATURE=0.2
***REMOVED*** LLM_MAX_TOKENS=2048
***REMOVED*** MODEL_NAME=                            ***REMOVED*** Generic model alias used by helpers.
***REMOVED*** GENERATE_MAX_TOKENS=512
***REMOVED*** SUPERVISOR_MODEL=gpt-4o-mini
***REMOVED*** REWRITE_MODEL=gpt-4o-mini
***REMOVED*** REWRITE_MAX_TOKENS=512
***REMOVED*** MAX_LLM_CALLS=12                       ***REMOVED*** Hard cap on LLM calls per turn.
***REMOVED*** MAX_TOOL_CALLS=6
***REMOVED*** MAX_REWRITE_ATTEMPTS=2
***REMOVED*** LOW_CONFIDENCE_THRESHOLD=0.3           ***REMOVED*** Confidence below which the bot triggers fallback.
***REMOVED*** API_PROVIDER=openai                    ***REMOVED*** openai | groq | anthropic — used by helper scripts.

***REMOVED*** ==============================================================================
***REMOVED*** RETRIEVAL / EMBEDDINGS / CACHE (advanced)
***REMOVED*** ==============================================================================
***REMOVED*** CLIENT_DIRECT_PIPELINE_ENABLED=true   ***REMOVED*** Bypass supervisor for client direct queries.
***REMOVED*** STREAMING_ENABLED=true                ***REMOVED*** Stream LLM tokens back to Telegram.
***REMOVED*** ENABLE_CACHING=true                    ***REMOVED*** Master switch for the multi-tier cache.
***REMOVED*** USE_LOCAL_DENSE_EMBEDDINGS=true       ***REMOVED*** Use local BGE-M3 for dense embeddings.
***REMOVED*** USE_HYDE=false                         ***REMOVED*** HyDE query expansion (***REMOVED***1652).
***REMOVED*** HYDE_MIN_WORDS=4                       ***REMOVED*** Minimum query length to trigger HyDE.
***REMOVED*** USE_CONTEXTUALIZED_EMBEDDINGS=false   ***REMOVED*** Anthropic contextualized embeddings.
***REMOVED*** CONTEXTUALIZED_EMBEDDING_DIM=1024
***REMOVED*** RERANK_PROVIDER=bge-m3                ***REMOVED*** bge-m3 | colbert | crossencoder
***REMOVED*** RETRIEVAL_DENSE_PROVIDER=bge-m3       ***REMOVED*** bge-m3 | voyage | userbase
***REMOVED*** EMBEDDING_BACKEND=bge-m3              ***REMOVED*** bge-m3 | voyage
***REMOVED*** SEARCH_ENGINE=hybrid_rrf              ***REMOVED*** hybrid_rrf | hybrid_rrf_colbert | dense_only
***REMOVED*** SEARCH_TOP_K=40                        ***REMOVED*** Qdrant hybrid search top-k.
***REMOVED*** RERANK_TOP_K=7                         ***REMOVED*** ColBERT rerank final top-k.
***REMOVED*** RELEVANCE_THRESHOLD_RRF=0.005         ***REMOVED*** Min RRF score to keep a document.
***REMOVED*** HYBRID_DENSE_WEIGHT=0.6
***REMOVED*** HYBRID_SPARSE_WEIGHT=0.4
***REMOVED*** BGE_M3_CONCURRENCY=1                  ***REMOVED*** Threads for local BGE-M3 inference.
***REMOVED*** COLBERT_COVERAGE_WARN_THRESHOLD=0.5
***REMOVED*** Cache thresholds.
***REMOVED*** SEMANTIC_CACHE_THRESHOLD=0.92
***REMOVED*** SEMANTIC_CACHE_TTL_DEFAULT=3600
***REMOVED*** Quantization tuning (overrides QDRANT_QUANTIZATION_* below for bot fast-path).
***REMOVED*** QUANTIZATION_MODE=off
***REMOVED*** QUANTIZATION_RESCORE=true
***REMOVED*** QUANTIZATION_OVERSAMPLING=2.0
***REMOVED*** QDRANT_QUANTIZATION_ALWAYS_RAM=false
***REMOVED*** QDRANT_TIMEOUT=30
***REMOVED*** QDRANT_BACKUP_DIR=                    ***REMOVED*** Local path used by scripts/backup_qdrant.sh.

***REMOVED*** ==============================================================================
***REMOVED*** DEV STACK CONFIGURATION
***REMOVED*** ==============================================================================

***REMOVED*** Telegram Bot (TELEGRAM_BOT_TOKEN defined above in required section)
BOT_USERNAME=
SUPERVISOR_MAX_TOKENS=1024
***REMOVED*** TTFT drift warning threshold (ms). Raise for reasoning models behind proxy (***REMOVED***675)
TTFT_DRIFT_WARN_MS=500
***REMOVED*** Runtime reasoning request params forwarded by the graph/generation path.
***REMOVED*** LiteLLM keeps provider configs static; these envs tune per-request kwargs instead.
***REMOVED*** REASONING_EFFORT=low         ***REMOVED*** gpt-oss-120b: low/medium(default)/high
***REMOVED*** REASONING_FORMAT=hidden      ***REMOVED*** gpt-oss-120b: hidden/parsed/raw/none
***REMOVED*** DISABLE_REASONING=true       ***REMOVED*** zai-glm-4.7: true/false

***REMOVED*** Qdrant Quantization (bot)
QDRANT_QUANTIZATION_MODE=off
QDRANT_USE_QUANTIZATION=true
QDRANT_QUANTIZATION_RESCORE=true
QDRANT_QUANTIZATION_OVERSAMPLING=2.0

***REMOVED*** Small-to-big context expansion (bot)
SMALL_TO_BIG_MODE=off
SMALL_TO_BIG_WINDOW_BEFORE=1
SMALL_TO_BIG_WINDOW_AFTER=1
MAX_EXPANDED_CHUNKS=10
MAX_CONTEXT_TOKENS=8000

***REMOVED*** Langfuse (optional - for LLM tracing)
***REMOVED*** LANGFUSE_HOST is for host-side tools and browser-accessible local dev.
***REMOVED*** Containerized services use LANGFUSE_DOCKER_HOST and default to the Docker network alias.
***REMOVED*** On VPS without local Langfuse, set both LANGFUSE_HOST and LANGFUSE_DOCKER_HOST
***REMOVED*** to the same reachable value (for example https://cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=[REDACTED-LANGFUSE-KEY]
LANGFUSE_SECRET_KEY=[REDACTED-LANGFUSE-KEY]
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_DOCKER_HOST=http://langfuse:3000
***REMOVED*** ENABLE_LANGFUSE=true                ***REMOVED*** Soft kill-switch for the Langfuse client.
***REMOVED*** LANGFUSE_TRACING_ENABLED=true        ***REMOVED*** Same as ENABLE_LANGFUSE; some scripts read either.
***REMOVED*** LANGFUSE_BASE_URL=                   ***REMOVED*** Alias of LANGFUSE_HOST; some scripts read either.
***REMOVED*** Isolate traces by environment in Langfuse UI (prod/staging/dev). Optional.
***REMOVED*** LANGFUSE_TRACING_ENVIRONMENT=staging
***REMOVED*** Flush config (defaults match Langfuse SDK: flush_at=512, flush_interval=5.0s). Optional.
***REMOVED*** LANGFUSE_FLUSH_AT=512
***REMOVED*** LANGFUSE_FLUSH_INTERVAL=5.0
***REMOVED*** Prompt label to fetch from Langfuse (default: production). Optional.
***REMOVED*** LANGFUSE_PROMPT_LABEL=production

***REMOVED*** OpenTelemetry service identity for Langfuse/OTel traces.
***REMOVED*** Each service sets a default automatically in Compose; override only when needed.
***REMOVED*** OTEL_SERVICE_NAME=telegram-bot

***REMOVED*** Content filter / guard
***REMOVED*** GUARD_MODE=hard                    ***REMOVED*** hard (block) | soft (flag+continue) | log (log only)
***REMOVED*** CONTENT_FILTER_ENABLED=true
***REMOVED*** ENABLE_OFF_TOPIC_DETECTION=true
***REMOVED*** ENABLE_QUERY_EXPANSION=false
***REMOVED*** ENABLE_CONFIDENCE_SCORING=true
***REMOVED*** RESPONSE_STYLE_ENABLED=true
***REMOVED*** RESPONSE_STYLE_SHADOW_MODE=false
***REMOVED*** CLASSIFIER_MODE=hybrid              ***REMOVED*** llm | regex | hybrid
***REMOVED*** SHOW_SOURCES=false                  ***REMOVED*** Append source citations to answers.
***REMOVED*** SHOW_TRANSCRIPTION=false            ***REMOVED*** Echo voice-note transcripts back to user.

