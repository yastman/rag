# ==============================================================================
# КОНФИГУРАЦИЯ ОКРУЖЕНИЯ
# ==============================================================================
#
# ДЛЯ ЛОКАЛЬНОЙ РАБОТЫ:
#   - Используйте этот файл как .env (`cp .env.example .env`)
#   - QDRANT_URL=http://localhost:6333
#
# Bidirectional sync контракт: tests/contract/test_env_example_completeness_contract.py
# Любой `os.getenv(...)` в production-коде должен быть либо в этом файле,
# либо в `ALLOWLIST_NOT_IN_ENV_EXAMPLE` (runtime-only/test-only/SDK-internal vars).
# ==============================================================================

# ==============================================================================
# Docker Compose environment selection
# ==============================================================================
# Local dev (default):
COMPOSE_FILE=compose.yml:compose.dev.yml
COMPOSE_PROJECT_NAME=dev

# ==============================================================================
# REQUIRED FOR BOT PROFILE (make docker-bot-up)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
# Legacy Mini App fallback; prefer TELEGRAM_BOT_TOKEN for new runtime.
BOT_TOKEN=
LITELLM_MASTER_KEY=

# ==============================================================================
# BOT CORE
# ==============================================================================
# Logical environment name (development, staging, production). Used for log
# tagging and Langfuse trace environment isolation.
ENV=development
# Enable verbose logging and debug-only behaviour. Never set this on prod.
DEBUG=false
# Logging configuration.
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text | json (json for prod log shipping)
# LOG_FILE=                       # Optional: path to log file. Empty -> stderr only.
# ADMIN_IDS=12345,67890           # Comma-separated Telegram user IDs with admin commands.
# BOT_DOMAIN=                     # Public webhook domain (only required for webhook mode).
# BOT_LANGUAGE=ru                 # Default UI language for the bot (ru, en, uk).
# Telegram start-command retry tuning (used by PropertyBot.start polling lock).
# BOT_START_MAX_ATTEMPTS=10
# BOT_START_RETRY_DELAY_SEC=2
# BOT_START_RETRY_MAX_SEC=60
# Mini App / WebApp launch URL surfaced in inline keyboards.
# MINI_APP_URL=https://example.com/miniapp
MINI_APP_ALLOWED_ORIGIN=https://t.me

# ==============================================================================
# LOCAL EMBEDDINGS (BGE-M3, default for dev and VPS)
# ==============================================================================
BGE_M3_TIMEOUT=120
COLBERT_TIMEOUT=120
RERANK_CANDIDATES_MAX=10
# Skip reranking when RRF fusion score >= threshold
# Must be > 1/61 (≈0.01639, single-query top-1 RRF) to avoid always skipping
SKIP_RERANK_THRESHOLD=0.018
OMP_NUM_THREADS=4

# ==============================================================================
# DATABASE CREDENTIALS (compose services)
# ==============================================================================
POSTGRES_PASSWORD=<change-me>  # Change in production!
REDIS_PASSWORD=<change-me>  # Change in production!
# If you change REDIS_PASSWORD locally, run: make local-redis-recreate
# Optional native-run override. When unset, the bot derives:
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
REDIS_MAXMEMORY=512mb  # dev: 512mb, VPS: 256mb (default in compose.yml)
# REDIS_HOST=localhost            # Redis host for native-run; compose uses service alias.
# REDIS_PORT=6379                 # Redis port for native-run.

# ==============================================================================
# REQUIRED FOR ML PROFILE (make docker-ml-up, langfuse)
# ==============================================================================
NEXTAUTH_SECRET=   # generate: openssl rand -base64 32
SALT=              # generate: openssl rand -base64 32
ENCRYPTION_KEY=    # generate: openssl rand -hex 32

# ==============================================================================
# DEV INFRASTRUCTURE (optional overrides, defaults work out of the box)
# ==============================================================================
# Required in VPS/prod; dev override has local defaults.
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=

# ==============================================================================
# LLM PROVIDERS (at least one required for bot profile)
# ==============================================================================
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Anthropic Claude API (optional)
ANTHROPIC_API_KEY=

# Qdrant Vector Database
# Local development (Docker internal):
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key-here  # Uncomment only if your Qdrant instance requires auth
QDRANT_COLLECTION=gdrive_documents_bge
QDRANT_HISTORY_COLLECTION=conversation_history
# HISTORY_RELEVANCE_THRESHOLD=0.7  # Min similarity score for history results (0.0-1.0, default 0.7; #433)

# BGE-M3 Embedding API (Docker internal, used by bot automatically)
# BGE_M3_URL=http://localhost:8000

# Docling API (optional)
DOCLING_URL=http://localhost:5001

# Unified Google Drive ingestion (required for ingestion service / VPS deploys)
GDRIVE_SYNC_DIR=/absolute/path/to/drive-sync
GDRIVE_COLLECTION_NAME=gdrive_documents_bge
INGESTION_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cocoindex

# ==============================================================================
# LLM TUNING (advanced)
# ==============================================================================
# Bot calls LLM via LiteLLM proxy by default. Override per provider via the
# proxy config (config/litellm.yaml) — these knobs only affect bot-side request
# kwargs and graph behaviour.
LLM_BASE_URL=http://localhost:4000
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=                          # Per-provider override; usually not needed (LiteLLM proxy).
# LITELLM_BASE_URL=http://localhost:4000  # Alias used by some scripts (#1670).
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048
# MODEL_NAME=                            # Generic model alias used by helpers.
# GENERATE_MAX_TOKENS=512
# SUPERVISOR_MODEL=gpt-4o-mini
# REWRITE_MODEL=gpt-4o-mini
# REWRITE_MAX_TOKENS=512
# MAX_LLM_CALLS=12                       # Hard cap on LLM calls per turn.
# MAX_TOOL_CALLS=6
# MAX_REWRITE_ATTEMPTS=2
# LOW_CONFIDENCE_THRESHOLD=0.3           # Confidence below which the bot triggers fallback.
# API_PROVIDER=openai                    # openai | groq | anthropic — used by helper scripts.

# ==============================================================================
# RETRIEVAL / EMBEDDINGS / CACHE (advanced)
# ==============================================================================
# CLIENT_DIRECT_PIPELINE_ENABLED=true   # Bypass supervisor for client direct queries.
# STREAMING_ENABLED=true                # Stream LLM tokens back to Telegram.
# ENABLE_CACHING=true                    # Master switch for the multi-tier cache.
# USE_LOCAL_DENSE_EMBEDDINGS=true       # Use local BGE-M3 for dense embeddings.
# USE_HYDE=false                         # HyDE query expansion (#1652).
# HYDE_MIN_WORDS=4                       # Minimum query length to trigger HyDE.
# USE_CONTEXTUALIZED_EMBEDDINGS=false   # Anthropic contextualized embeddings.
# CONTEXTUALIZED_EMBEDDING_DIM=1024
# RERANK_PROVIDER=bge-m3                # bge-m3 | colbert | crossencoder
# RETRIEVAL_DENSE_PROVIDER=bge-m3       # bge-m3 | voyage | userbase
# EMBEDDING_BACKEND=bge-m3              # bge-m3 | voyage
# SEARCH_ENGINE=hybrid_rrf              # hybrid_rrf | hybrid_rrf_colbert | dense_only
# SEARCH_TOP_K=40                        # Qdrant hybrid search top-k.
# RERANK_TOP_K=7                         # ColBERT rerank final top-k.
# RELEVANCE_THRESHOLD_RRF=0.005         # Min RRF score to keep a document.
# HYBRID_DENSE_WEIGHT=0.6
# HYBRID_SPARSE_WEIGHT=0.4
# BGE_M3_CONCURRENCY=1                  # Threads for local BGE-M3 inference.
# COLBERT_COVERAGE_WARN_THRESHOLD=0.5
# Cache thresholds.
# SEMANTIC_CACHE_THRESHOLD=0.92
# SEMANTIC_CACHE_TTL_DEFAULT=3600
# Quantization tuning (overrides QDRANT_QUANTIZATION_* below for bot fast-path).
# QUANTIZATION_MODE=off
# QUANTIZATION_RESCORE=true
# QUANTIZATION_OVERSAMPLING=2.0
# QDRANT_QUANTIZATION_ALWAYS_RAM=false
# QDRANT_TIMEOUT=30
# QDRANT_BACKUP_DIR=                    # Local path used by scripts/backup_qdrant.sh.

# ==============================================================================
# DEV STACK CONFIGURATION
# ==============================================================================

# Telegram Bot (TELEGRAM_BOT_TOKEN defined above in required section)
BOT_USERNAME=
SUPERVISOR_MAX_TOKENS=1024
# TTFT drift warning threshold (ms). Raise for reasoning models behind proxy (#675)
TTFT_DRIFT_WARN_MS=500
# Runtime reasoning request params forwarded by the graph/generation path.
# LiteLLM keeps provider configs static; these envs tune per-request kwargs instead.
# REASONING_EFFORT=low         # gpt-oss-120b: low/medium(default)/high
# REASONING_FORMAT=hidden      # gpt-oss-120b: hidden/parsed/raw/none
# DISABLE_REASONING=true       # zai-glm-4.7: true/false

# Qdrant Quantization (bot)
QDRANT_QUANTIZATION_MODE=off
QDRANT_USE_QUANTIZATION=true
QDRANT_QUANTIZATION_RESCORE=true
QDRANT_QUANTIZATION_OVERSAMPLING=2.0

# Small-to-big context expansion (bot)
SMALL_TO_BIG_MODE=off
SMALL_TO_BIG_WINDOW_BEFORE=1
SMALL_TO_BIG_WINDOW_AFTER=1
MAX_EXPANDED_CHUNKS=10
MAX_CONTEXT_TOKENS=8000

# Langfuse (optional - for LLM tracing)
# LANGFUSE_HOST is for host-side tools and browser-accessible local dev.
# Containerized services use LANGFUSE_DOCKER_HOST and default to the Docker network alias.
# On VPS without local Langfuse, set both LANGFUSE_HOST and LANGFUSE_DOCKER_HOST
# to the same reachable value (for example https://cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=[REDACTED-LANGFUSE-KEY]
LANGFUSE_SECRET_KEY=[REDACTED-LANGFUSE-KEY]
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_DOCKER_HOST=http://langfuse:3000
# ENABLE_LANGFUSE=true                # Soft kill-switch for the Langfuse client.
# LANGFUSE_TRACING_ENABLED=true        # Same as ENABLE_LANGFUSE; some scripts read either.
# LANGFUSE_BASE_URL=                   # Alias of LANGFUSE_HOST; some scripts read either.
# Isolate traces by environment in Langfuse UI (prod/staging/dev). Optional.
# LANGFUSE_TRACING_ENVIRONMENT=staging
# Flush config (defaults match Langfuse SDK: flush_at=512, flush_interval=5.0s). Optional.
# LANGFUSE_FLUSH_AT=512
# LANGFUSE_FLUSH_INTERVAL=5.0
# Prompt label to fetch from Langfuse (default: production). Optional.
# LANGFUSE_PROMPT_LABEL=production

# Sentry-compatible error tracking (optional; see docs/observability/bugsink-setup.md).
# SENTRY_TRACES_SAMPLE_RATE=0.0       # 0.0 = errors only; raise cautiously after storage review.
# SENTRY_DEBUG=false                  # Enable sentry-sdk debug logging for local troubleshooting.

# OpenTelemetry service identity for Langfuse/OTel traces.
# Each service sets a default automatically in Compose; override only when needed.
# OTEL_SERVICE_NAME=telegram-bot

# Content filter / guard
# GUARD_MODE=hard                    # hard (block) | soft (flag+continue) | log (log only)
# CONTENT_FILTER_ENABLED=true
# ENABLE_OFF_TOPIC_DETECTION=true
# ENABLE_QUERY_EXPANSION=false
# ENABLE_CONFIDENCE_SCORING=true
# RESPONSE_STYLE_ENABLED=true
# RESPONSE_STYLE_SHADOW_MODE=false
# CLASSIFIER_MODE=hybrid              # llm | regex | hybrid
# SHOW_SOURCES=false                  # Append source citations to answers.
# SHOW_TRANSCRIPTION=false            # Echo voice-note transcripts back to user.

# MLflow (optional - for experiment tracking)
MLFLOW_TRACKING_URI=http://localhost:5000

# Voyage AI (OPTIONAL — legacy, not used in default dev/VPS config)
# VOYAGE_API_KEY=
# VOYAGE_EMBED_MODEL=voyage-3-large
# VOYAGE_CACHE_MODEL=voyage-3-lite
# VOYAGE_RERANK_MODEL=rerank-2

# ==============================================================================
# LITELLM PROXY (LLM Gateway)
# ==============================================================================
# LITELLM_MASTER_KEY, CEREBRAS_API_KEY, OPENAI_API_KEY, GROQ_API_KEY
# are all defined above in required/LLM providers sections

# ==============================================================================
# E2E TESTING (Telethon userbot)
# ==============================================================================
# Get credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your-api-hash-here
E2E_BOT_USERNAME=@test_your_bot

# Path to a local audio file used for voice-note E2E scenarios (8.1–8.3).
# If unset or empty, voice scenarios will raise a clear RuntimeError.
# A synthetic OGG/Opus fixture is provided for CI and local dev (no real voice data).
E2E_VOICE_NOTE_PATH=data/test/voice_note_sample.ogg  # Synthetic voice note fixture for e2e tests (#1486)

# ==============================================================================
# ALERTING (Telegram notifications via Alertmanager)
# ==============================================================================
# Create a separate bot for alerts via @BotFather (not the main bot!)
# See docs/ALERTING.md for setup instructions
TELEGRAM_ALERTING_BOT_TOKEN=[REDACTED-TELEGRAM-TOKEN]
# Chat ID for alerts (use @userinfobot to get your chat ID)
# For groups: add bot to group and use negative chat ID
TELEGRAM_ALERTING_CHAT_ID=-1001234567890

# ==============================================================================
# VOICE BOT (LiveKit Agents + SIP)
# ==============================================================================
ELEVENLABS_API_KEY=
LIVEKIT_URL=ws://livekit-server:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIFECELL_SIP_USER=
LIFECELL_SIP_PASS=
RAG_API_URL=http://rag-api:8080
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
# ELEVENLABS_VOICE_ID=                 # Override default ElevenLabs voice id.
# STT_MODEL=whisper-large-v3           # Speech-to-text model used by voice agent.
# VOICE_LANGUAGE=ru                    # Default voice agent language.
# VOICE_DATABASE_URL=postgresql://...  # Voice-bot Postgres URL (separate from main DATABASE_URL).
# SIP_TRUNK_ID=                        # LiveKit SIP trunk identifier.
# LIFECELL_SIP_NUMBER=                 # Outbound caller-ID for Lifecell SIP.

# ==============================================================================
# SESSION SUMMARY + CRM (#305)
# ==============================================================================
SESSION_SUMMARY_ENABLED=false
SESSION_TIMEOUT_MINUTES=30
KOMMO_ENABLED=false
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=
KOMMO_TELEGRAM_FIELD_ID=0

# Kommo OAuth2 (for token refresh)
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
KOMMO_REDIRECT_URI=
KOMMO_AUTH_CODE=

# Kommo pipeline config
KOMMO_DEFAULT_PIPELINE_ID=0
KOMMO_RESPONSIBLE_USER_ID=
KOMMO_SESSION_FIELD_ID=0
KOMMO_LEAD_SCORE_FIELD_ID=0
KOMMO_LEAD_BAND_FIELD_ID=0
KOMMO_NEW_STATUS_ID=0
KOMMO_SERVICE_FIELD_ID=0
KOMMO_SOURCE_FIELD_ID=0
KOMMO_TELEGRAM_USERNAME_FIELD_ID=0
# KOMMO_LOST_STATUS_ID=0
# KOMMO_WON_STATUS_ID=0

# Manager config
MANAGER_IDS=
MANAGER_HOT_LEAD_THRESHOLD=60
MANAGER_HOT_LEAD_DEDUPE_SEC=3600

# Real Estate Database
REALESTATE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/realestate

# ── Handoff (Forum Topics) ──────────────────────────────────────
# HANDOFF_ENABLED=false
# MANAGERS_GROUP_ID=-1001234567890   # Supergroup with Topics enabled
# HANDOFF_TTL_HOURS=24
# HANDOFF_SUMMARY_MIN_MESSAGES=3
# BUSINESS_HOURS_START=9
# BUSINESS_HOURS_END=18
# BUSINESS_HOURS_TZ=Europe/Sofia
# HANDOFF_WAIT_TIMEOUT_MIN=15
