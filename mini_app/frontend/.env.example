# Mini App frontend environment configuration.
# Copy to `.env.local` (gitignored) and adjust per deployment.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Backend API base URL. In dev, Vite proxies /api -> localhost:8090.
# VITE_API_URL=/api

# Telegram bot username (without the leading @) used by TelegramGate
# to render the "Open in Telegram" CTA link (https://t.me/<username>).
# Must match the backend BOT_USERNAME env var. See mini_app/api.py.
VITE_BOT_USERNAME=YourBotName
