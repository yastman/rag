# Import-linter standalone config file (#2869).
# Mirrors the [tool.importlinter] section in pyproject.toml.
# This file exists so `lint-imports` can be run without pyproject.toml parsing,
# and to make the layering contract explicit at the repo root.
#
# Layer model (inner cannot import outer):
#   src/core  →  src/runtime  →  telegram_bot
#
# Run: uv run lint-imports
# Makefile: make arch-lint

[importlinter]
root_packages =
    src
    telegram_bot
include_external_packages = True

[importlinter:contract:core-no-telegram-bot]
name = Core must not import telegram_bot
type = forbidden
source_modules =
    src.core
forbidden_modules =
    telegram_bot

[importlinter:contract:runtime-no-telegram-bot]
name = Runtime must not import telegram_bot
type = forbidden
source_modules =
    src.runtime
forbidden_modules =
    telegram_bot

[importlinter:contract:core-contracts-independent]
name = Core contracts layer is import-independent
type = independence
modules =
    src.core.contracts

[importlinter:contract:src-no-archive]
name = src must not import archive
type = forbidden
source_modules =
    src
forbidden_modules =
    archive
